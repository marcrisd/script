    local function fmt(n)
        local sfx = {"K","M","B","T","Qa","Qi","Sx","Sp","Oc","No","Dc"}
        if n < 1000 then return tostring(math.floor(n)) end
        local i = math.floor(math.log(n) / math.log(1000))
        i = math.max(1, math.min(i, #sfx))
        return string.format("%.2f%s", n / 1000^i, sfx[i])
    end

    while task.wait(1) do
        local elapsed = os.clock() - startTime
        TimeEclapsedStat:Update(tostring(utils:FormatTime(elapsed)))

        -- Balance display (current snapshot)
        local currentCoins = client:get("coins") or 0
        local currentGoop  = client:get("goop")  or 0
        local now = os.clock()

        CoinsStat:Update(utils:FormatNumber(currentCoins))
        GoopStat:Update(utils:FormatNumber(currentGoop))

        -- Accurate event-based rates
        local el = math.max(tick() - rewardStart, 1)
        CoinRateStat:Update(fmt(coinTotal / el * 3600) .. "/hr  |  " .. fmt(coinTotal / el * 60) .. "/min")
        GoopRateStat:Update(fmt(goopTotal / el * 3600) .. "/hr  |  " .. fmt(goopTotal / el * 60) .. "/min")

        -- Balance-delta spike filtering (kept for benchmark accuracy)
        local coinSpendRecently = (now - lastCoinSpend) < SPIKE_COOLDOWN
        local goopSpendRecently = (now - lastGoopSpend) < SPIKE_COOLDOWN
        if not coinSpendRecently then table.insert(coinSamples, {t=now, v=currentCoins}) end
        if not goopSpendRecently then table.insert(goopSamples, {t=now, v=currentGoop}) end
        if #coinSamples >= 2 then
            local oldest = coinSamples[1]
            local dt = now - oldest.t
            if dt >= MIN_WINDOW then coinsPerHour = ((currentCoins - oldest.v) / dt) * 3600 end
        end
        if #goopSamples >= 2 then
            local oldest = goopSamples[1]
            local dt = now - oldest.t
            if dt >= MIN_WINDOW then goopPerHour = ((currentGoop - oldest.v) / dt) * 3600 end
        end

        RollsStat:Update(TotalRolls)
        ZoneStat:Update(math.max(client:get("maxZone") or 1, 1))
        RebirthStat:Update(client:get("rebirths") or 0)
        LuckStat:Update(utils:FormatNumber(RollSlice.luck))

