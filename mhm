-- LOOP 6: ZONE BENCHMARK / FORCE ZONE
-- =====================================================
if cfg("Zone Benchmark", true) or cfg("Force Zone", nil) ~= nil then
    task.spawn(function()
        task.wait(5)

        local forcedZone = cfg("Force Zone", nil)
        if forcedZone ~= nil then
            forcedZone = tonumber(forcedZone)
            print(string.format("[Zone] Force Zone set — locking to zone %d", forcedZone))
            StatusStat:Update("Forced Zone: " .. forcedZone)
            getgenv()._BenchmarkBestZone = forcedZone
            while task.wait(2) do
                teleportToZone(forcedZone)
            end
            return
        end

        local SAMPLE_TIME = 180
        local TOP_N       = 5

        local function runBenchmark()
            local currentMax  = math.max(client:get("maxZone") or 1, 1)
            local zonesToTest = {}
            for i = math.max(1, currentMax - (TOP_N - 1)), currentMax do
                if zonesTable[i] then table.insert(zonesToTest, i) end
            end

            StatusStat:Update("Benchmarking Zones...")
            print("[Benchmark] Testing " .. #zonesToTest .. " zones × " .. SAMPLE_TIME .. "s each")
            getgenv()._BenchmarkRunning = true

            local results = {}
            for idx, zoneId in ipairs(zonesToTest) do
                StatusStat:Update("Benchmarking Zone " .. zoneId .. " (" .. idx .. "/" .. #zonesToTest .. ")...")
                teleportToZone(zoneId)

                -- Reset both tracking methods for clean per-zone measurement
                goopSamples = {}
                goopPerHour = 0
                local goopBase = goopTotal  -- use event-based total for accuracy

                task.wait(SAMPLE_TIME)

                local earned         = goopTotal - goopBase
                local goopPerHourEst = (earned / SAMPLE_TIME) * 3600
                results[zoneId]      = goopPerHourEst
                print(string.format("[Benchmark] Zone %d → %s goop/hr", zoneId, utils:FormatNumber(goopPerHourEst)))
            end

            getgenv()._BenchmarkRunning = false

            local bestZone, bestRate = 1, -math.huge
            for zoneId, rate in pairs(results) do
                if rate > bestRate then bestRate = rate bestZone = zoneId end
            end
            print(string.format("[Benchmark] Done! Best zone: %d (%s goop/hr)", bestZone, utils:FormatNumber(bestRate)))
            StatusStat:Update("Best Zone: " .. bestZone .. " (" .. utils:FormatNumber(bestRate) .. "/hr)")
            return bestZone, bestRate
        end

        local bestZone, bestRate = runBenchmark()
        getgenv()._BenchmarkBestZone = bestZone
        local lastKnownZone = math.max(client:get("maxZone") or 1, 1)

        task.spawn(function()
            while task.wait(2) do
                local currentMax   = math.max(client:get("maxZone") or 1, 1)
                local nextZoneData = Zones.getZone(currentMax + 1)
                if nextZoneData and client:get("coins") >= nextZoneData.price then
                    lastCoinSpend = os.clock()
                    ZonesService.RemoteFunction:InvokeServer("requestPurchaseZone")
                    local newMax = math.max(client:get("maxZone") or 1, 1)
                    if newMax > lastKnownZone then
                        print(string.format("[Zone] Bought zone %d — triggering re-benchmark", newMax))
                        lastKnownZone = newMax
                        getgenv()._BenchmarkBestZone = nil
                        task.wait(1)
                        for _, zone in ipairs(Workspace:WaitForChild("Zones"):GetChildren()) do
                            if zone:FindFirstChild("POI") and zone.POI:FindFirstChild("Baseplate") then
                                zonesTable[tonumber(zone.Name)] = zone.POI.Baseplate.Position + Vector3.new(0, 3, 0)
                            end
                        end
                        bestZone, bestRate = runBenchmark()
                        getgenv()._BenchmarkBestZone = bestZone
                    end
                end
            end
        end)

        while task.wait(2) do
            local target = getgenv()._BenchmarkBestZone
            if target then teleportToZone(target) end
        end
    end)
end

