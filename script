-- STATE
local collecting, hatching, clicking, mutating, upgrading, ascending = false, false, false, false, false, false
local connection = nil

-- REMOTE LOADER
local function getRemote(path)
    local ok, result = pcall(function()
        local node = RS
        for _, key in ipairs(path) do
            node = node:WaitForChild(key, 5)
        end
        return node
    end)
    return ok and result or nil
end

local RF, EggRF, ClickRF, CritRF, PetRF, MutateRF, UpgradeRF, AscendRF

task.spawn(function()
    repeat task.wait() until RS:FindFirstChild("Packages")

    RF        = getRemote({"Packages","Knit","Services","CarrotSpawningService","RF","CarrotCollected"})
    EggRF     = getRemote({"Packages","Knit","Services","EggService","RF","purchaseEgg"})
    ClickRF   = getRemote({"Packages","Knit","Services","ArmWrestleService","RF","RequestClick"})
    CritRF    = getRemote({"Packages","Knit","Services","ArmWrestleService","RF","RequestCritHit"})
    PetRF     = getRemote({"Packages","Knit","Services","PetService","RF","getOwned"})
    MutateRF  = getRemote({"Packages","Knit","Services","PetCombineService","RF","mutate"})
    UpgradeRF = getRemote({"Packages","Knit","Services","CarrotUpgradesService","RF","BuyUpgrade"})
    AscendRF  = getRemote({"Packages","Knit","Services","CarrotAscensionService","RF","BuyAscension"})
end)

-- AUTO COLLECT CARROTS 
local carrotFolder = workspace:WaitForChild("GameObjects"):WaitForChild("Carrots")

local function collectCarrot(carrot)
    if not RF then return end
    local zone = carrot:GetAttribute("CarrotZone")
    local guid = carrot:GetAttribute("CarrotGuid")

    if zone and guid then
        pcall(function()
            RF:InvokeServer(zone, guid)
        end)
        carrot:Destroy()
    end
end

local function startCollecting()
    for _, carrot in ipairs(carrotFolder:GetChildren()) do
        collectCarrot(carrot)
    end

    connection = carrotFolder.ChildAdded:Connect(function(carrot)
        task.wait(0.05)
        collectCarrot(carrot)
    end)
end

local function stopCollecting()
    if connection then
        connection:Disconnect()
        connection = nil
    end
end

-- AUTO MUTATE (ALL PETS)
local function autoMutateAll()
    if not PetRF or not MutateRF then return end

    local success, pets = pcall(function()
        return PetRF:InvokeServer()
    end)

    if not success or typeof(pets) ~= "table" then return end

    for uuid, data in pairs(pets) do
        if data and not data.Locked and not data.Cure then
            pcall(function()
                MutateRF:InvokeServer(uuid, {})
            end)
            task.wait(0.5) -- small delay to avoid spam
        end
    end
end

-- AUTO UPGRADE 
local function startAutoUpgrade()
    while upgrading do
        if UpgradeRF then
            pcall(function()
                UpgradeRF:InvokeServer("BunnyBurrow", "MoreCarrots")
            end)

            task.wait(0.2)

            pcall(function()
                UpgradeRF:InvokeServer("BunnyBurrow", "MoreSpawns")
            end)
        end
        task.wait(0.5)
    end
end

-- AUTO CLICK
local function startClicking()
    task.spawn(function()
        while clicking do
            if ClickRF then
                pcall(function()
                    ClickRF:InvokeServer(true)
                end)
            end

            -- occasionally attempt crits
            if CritRF then
                pcall(function()
                    CritRF:InvokeServer()
                end)
            end

            task.wait(0.03) -- adjust speed if needed
        end
    end)
end

-- AUTO HATCH
local function startHatching()
    while hatching do
        if EggRF then
            pcall(function()
                EggRF:InvokeServer("Bunny", nil, nil, false)
            end)
        end
        task.wait(0.1)
    end
end

-- AUTO ASCEND
local function startAutoAscend()
    while ascending do
        if AscendRF then
            pcall(function()
                AscendRF:InvokeServer("BunnyBurrow")
            end)
        end
        task.wait(math.random(3,5))
    end
end

